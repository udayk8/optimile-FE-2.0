{
  "name": "frontend-main",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:vendor": "vite --host 127.0.0.1 --mode vendor",
    "dev:auction": "vite --host 127.0.0.1 --mode auction",
    "dev:auction:standalone": "npm run dev -w @optimile/auction-portal-web",
    "dev:vendor:standalone": "npm run dev -w @optimile/vendor-portal-web",
    "dev:fleet:standalone": "npm run dev -w @optimile/fleet-web",
    "dev:finance:standalone": "npm run dev -w @optimile/finance-web",
    "dev:customer:standalone": "npm run dev -w @optimile/customer-web",
    "dev:console:standalone": "npm run dev -w @optimile/console-web",
    "build": "npm run build -w @optimile/shared-utils && npm run build -w @optimile/shared-auth && npm run build -w @optimile/shared-ui && npm run build -w @optimile/shared-api && vite build && npm run build -w @optimile/auction-portal-web && npm run build -w @optimile/vendor-portal-web && npm run build -w @optimile/customer-web && npm run build -w @optimile/fleet-web && npm run build -w @optimile/console-web && npm run build -w @optimile/finance-web"
  },
  "dependencies": {
    "@optimile/auction-portal-web": "file:modules/auction-web",
    "@optimile/console-web": "file:modules/console-web",
    "@optimile/finance-web": "file:modules/finance-web",
    "@optimile/fleet-web": "file:modules/fleet-web",
    "@optimile/shared-auth": "file:packages/shared-auth",
    "@optimile/shared-ui": "file:packages/shared-ui",
    "@optimile/vendor-portal-web": "file:modules/vendor-web",
    "@react-google-maps/api": "^2.20.8",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^4.3.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.0.10",
    "konva": "^9.3.22",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.7",
    "react-konva": "^19.0.10",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "vite": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
