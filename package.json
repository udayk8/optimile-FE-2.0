{
  "name": "frontend-main",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:vendor": "vite --host 127.0.0.1 --mode vendor",
    "dev:auction": "vite --host 127.0.0.1 --mode auction",
    "dev:admin:standalone": "npm run dev -w @optimile/admin-web",
    "dev:auction:standalone": "npm run dev -w @optimile/auction-portal-web",
    "dev:vendor:standalone": "npm run dev -w @optimile/vendor-portal-web",
    "dev:fleet:standalone": "npm run dev -w @optimile/fleet-web",
    "dev:customer:standalone": "npm run dev -w @optimile/customer-web",
    "dev:console:standalone": "npm run dev -w @optimile/console-web",
    "dev:platform-admin:standalone": "npm run dev -w @optimile/platform-admin-web",
    "dev:tenant-admin:standalone": "npm run dev -w @optimile/tenant-admin-web",
    "dev:tms-booking:standalone": "npm run dev -w @optimile/tms-booking-web",
    "dev:tms-driver-app:standalone": "npm run dev -w @optimile/tms-driver-app-web",
    "build": "npm run build -w @optimile/shared-utils && npm run build -w @optimile/shared-auth && npm run build -w @optimile/shared-ui && npm run build -w @optimile/shared-api && vite build && npm run build -w @optimile/auction-portal-web && npm run build -w @optimile/vendor-portal-web && npm run build -w @optimile/customer-web && npm run build -w @optimile/fleet-web && npm run build -w @optimile/console-web && npm run build -w @optimile/platform-admin-web && npm run build -w @optimile/tenant-admin-web && npm run build -w @optimile/tms-booking-web && npm run build -w @optimile/tms-driver-app-web"
  },
  "dependencies": {
    "@optimile/admin-web": "file:modules/admin-web",
    "@optimile/auction-portal-web": "file:modules/auction-web",
    "@optimile/console-web": "file:modules/console-web",
    "@optimile/fleet-web": "file:modules/fleet-web",
    "@optimile/platform-admin-web": "file:modules/platform-admin-web",
    "@optimile/shared-auth": "file:packages/shared-auth",
    "@optimile/shared-ui": "file:packages/shared-ui",
    "@optimile/tenant-admin-web": "file:modules/tenant-admin-web",
    "@optimile/tms-booking-web": "file:modules/tms-booking-web",
    "@optimile/tms-driver-app-web": "file:modules/tms-driver-app-web",
    "@optimile/vendor-portal-web": "file:modules/vendor-web",
    "@vitejs/plugin-react": "^4.3.0",
    "i18next": "^26.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.1.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
