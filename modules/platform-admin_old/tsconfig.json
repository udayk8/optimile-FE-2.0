{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/shared/components/common": ["./src/shared/components/common"],
      "@/shared/components/common/*": ["./src/shared/components/common/*"],
      "@/shared/components/ui": ["./src/shared/components/ui"],
      "@/shared/components/ui/*": ["./src/shared/components/ui/*"],
      "@/shared/components/layout": ["./src/shared/components/layout"],
      "@/shared/components/layout/*": ["./src/shared/components/layout/*"],
      "@/shared/auth": ["./src/shared/auth"],
      "@/shared/auth/*": ["./src/shared/auth/*"],
      "@/shared/lib": ["./src/shared/lib"],
      "@/shared/lib/*": ["./src/shared/lib/*"],
      "@/shared/store": ["./src/shared/store"],
      "@/shared/store/*": ["./src/shared/store/*"],
      "@/shared/mocks": ["./src/shared/mocks"],
      "@/shared/mocks/*": ["./src/shared/mocks/*"],
      "@/constants": ["./src/constants"],
      "@/constants/*": ["./src/constants/*"],
      "@/types": ["./src/types"],
      "@/types/*": ["./src/types/*"],
      "@/modules/platform-admin": ["./src/modules/platform-admin"],
      "@/modules/platform-admin/*": ["./src/modules/platform-admin/*"],
      "@/modules/tenant-admin": ["./src/modules/tenant-admin"],
      "@/modules/tenant-admin/*": ["./src/modules/tenant-admin/*"],
      "@/modules/tms": ["./src/modules/tms"],
      "@/modules/tms/*": ["./src/modules/tms/*"],
      "@platform-admin/*": ["./src/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@shared-auth": ["../../packages/shared-auth/src"],
      "@shared-auth/*": ["../../packages/shared-auth/src/*"],
      "@shared-api": ["../../packages/shared-api/src"],
      "@shared-api/*": ["../../packages/shared-api/src/*"],
      "@shared-ui": ["../../packages/shared-ui/src"],
      "@shared-ui/*": ["../../packages/shared-ui/src/*"],
      "@shared-utils": ["../../packages/shared-utils/src"],
      "@shared-utils/*": ["../../packages/shared-utils/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages"]
}

