{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/modules/platform-admin/hooks": ["packages/shared-admin-core/src/modules/platform-admin/hooks"],
      "@/modules/platform-admin/hooks/*": ["packages/shared-admin-core/src/modules/platform-admin/hooks/*"],
      "@/modules/platform-admin/lib": ["packages/shared-admin-core/src/modules/platform-admin/lib"],
      "@/modules/platform-admin/lib/*": ["packages/shared-admin-core/src/modules/platform-admin/lib/*"],
      "@/modules/platform-admin/components": ["modules/platform-admin-new/src/modules/platform-admin/components"],
      "@/modules/platform-admin/components/*": ["modules/platform-admin-new/src/modules/platform-admin/components/*"],
      "@/modules/platform-admin/pages": ["modules/platform-admin-new/src/modules/platform-admin/pages"],
      "@/modules/platform-admin/pages/*": ["modules/platform-admin-new/src/modules/platform-admin/pages/*"],
      "@/modules/platform-admin": ["modules/platform-admin-new/src/modules/platform-admin"],
      "@/modules/platform-admin/*": ["modules/platform-admin-new/src/modules/platform-admin/*"],
      "@/modules/tenant-admin/lib": ["packages/shared-admin-core/src/modules/tenant-admin/lib"],
      "@/modules/tenant-admin/lib/*": ["packages/shared-admin-core/src/modules/tenant-admin/lib/*"],
      "@/modules/tenant-admin": ["modules/tenant-admin-new/src/modules/tenant-admin"],
      "@/modules/tenant-admin/*": ["modules/tenant-admin-new/src/modules/tenant-admin/*"],
      "@/modules/tms": ["modules/tms/src/modules/tms"],
      "@/modules/tms/*": ["modules/tms/src/modules/tms/*"],
      "@/shared": ["packages/shared-admin-core/src/shared"],
      "@/shared/*": ["packages/shared-admin-core/src/shared/*"],
      "@/types": ["packages/shared-admin-core/src/types"],
      "@/types/*": ["packages/shared-admin-core/src/types/*"],
      "@/constants": ["packages/shared-admin-core/src/constants"],
      "@/constants/*": ["packages/shared-admin-core/src/constants/*"],
      "@shared-admin-core": ["packages/shared-admin-core/src"],
      "@shared-admin-core/*": ["packages/shared-admin-core/src/*"],
      "@platform-admin/hooks": ["packages/shared-admin-core/src/hooks"],
      "@platform-admin/hooks/*": ["packages/shared-admin-core/src/hooks/*"],
      "@platform-admin": ["modules/platform-admin-new/src"],
      "@platform-admin/*": ["modules/platform-admin-new/src/*"],
      "@tenant-admin": ["modules/tenant-admin-new/src"],
      "@tenant-admin/*": ["modules/tenant-admin-new/src/*"],
      "@layouts": ["packages/shared-admin-core/src/layouts"],
      "@layouts/*": ["packages/shared-admin-core/src/layouts/*"],
      "@constants": ["packages/shared-admin-core/src/constants"],
      "@constants/*": ["packages/shared-admin-core/src/constants/*"],
      "@auction": ["modules/auction-web/src"],
      "@auction/*": ["modules/auction-web/src/*"],
      "@vendor": ["modules/vendor-web/src"],
      "@vendor/*": ["modules/vendor-web/src/*"],
      "@fleet": ["modules/fleet-web/src"],
      "@fleet/*": ["modules/fleet-web/src/*"],
      "@customer": ["modules/customer-web/src"],
      "@customer/*": ["modules/customer-web/src/*"],
      "@console": ["modules/console-web/src"],
      "@console/*": ["modules/console-web/src/*"],
      "@track-trace": ["modules/track-trace-web/src"],
      "@track-trace/*": ["modules/track-trace-web/src/*"],
      "@tms-booking": ["modules/tms/src"],
      "@tms-booking/*": ["modules/tms/src/*"],
      "@shared-api": ["packages/shared-api/src"],
      "@shared-api/*": ["packages/shared-api/src/*"],
      "@shared-auth": ["packages/shared-auth/src"],
      "@shared-auth/*": ["packages/shared-auth/src/*"],
      "@shared-ui": ["packages/shared-ui/src"],
      "@shared-ui/*": ["packages/shared-ui/src/*"],
      "@shared-utils": ["packages/shared-utils/src"],
      "@shared-utils/*": ["packages/shared-utils/src/*"]
    }
  },
  "include": ["src", "modules", "packages", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "modules/tms",
    "modules/admin-web",
    "modules/console-web",
    "modules/customer-web",
    "modules/tms-booking-web",
    "modules/tms-driver-app-web"
  ]
}
