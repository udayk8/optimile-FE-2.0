{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/shared/components/common": [
        "modules/platform-admin/src/components/common"
      ],
      "@/shared/components/common/*": [
        "modules/platform-admin/src/components/common/*"
      ],
      "@/shared/components/ui": [
        "modules/platform-admin/src/components/ui"
      ],
      "@/shared/components/ui/*": [
        "modules/platform-admin/src/components/ui/*"
      ],
      "@/shared/auth": [
        "modules/platform-admin/src/shared/auth"
      ],
      "@/shared/auth/*": [
        "modules/platform-admin/src/shared/auth/*"
      ],
      "@/shared/lib": [
        "modules/platform-admin/src/lib"
      ],
      "@/shared/lib/*": [
        "modules/platform-admin/src/lib/*"
      ],
      "@/shared/store": [
        "modules/platform-admin/src/store"
      ],
      "@/shared/store/*": [
        "modules/platform-admin/src/store/*"
      ],
      "@/types": [
        "modules/platform-admin/src/types"
      ],
      "@/types/*": [
        "modules/platform-admin/src/types/*"
      ],
      "@/modules/platform-admin": [
        "modules/platform-admin/src/modules/platform-admin"
      ],
      "@/modules/platform-admin/*": [
        "modules/platform-admin/src/modules/platform-admin/*"
      ],
      "@/modules/tenant-admin": [
        "modules/tenant-admin/src/modules/tenant-admin"
      ],
      "@/modules/tenant-admin/*": [
        "modules/tenant-admin/src/modules/tenant-admin/*"
      ],
      "@/modules/tms": [
        "modules/tms/src/modules/tms"
      ],
      "@/modules/tms/*": [
        "modules/tms/src/modules/tms/*"
      ],
      "@admin": [
        "modules/auction-web/src"
      ],
      "@admin/*": [
        "modules/auction-web/src/*"
      ],
      "@admin-web": [
        "modules/admin-web/src"
      ],
      "@admin-web/*": [
        "modules/admin-web/src/*"
      ],
      "@auction": [
        "modules/auction-web/src"
      ],
      "@auction/*": [
        "modules/auction-web/src/*"
      ],
      "@vendor": [
        "modules/vendor-web/src"
      ],
      "@vendor/*": [
        "modules/vendor-web/src/*"
      ],
      "@fleet": [
        "modules/fleet-web/src"
      ],
      "@fleet/*": [
        "modules/fleet-web/src/*"
      ],
      "@customer": [
        "modules/customer-web/src"
      ],
      "@customer/*": [
        "modules/customer-web/src/*"
      ],
      "@console": [
        "modules/console-web/src"
      ],
      "@console/*": [
        "modules/console-web/src/*"
      ],
      "@platform-admin": [
        "modules/platform-admin/src"
      ],
      "@platform-admin/*": [
        "modules/platform-admin/src/*"
      ],
      "@tenant-admin": [
        "modules/tenant-admin/src"
      ],
      "@tenant-admin/*": [
        "modules/tenant-admin/src/*"
      ],
      "@tms-booking": [
        "modules/tms/src"
      ],
      "@tms-booking/*": [
        "modules/tms/src/*"
      ],
      "@tms-driver-app": [
        "modules/tms-driver-app-web/src"
      ],
      "@tms-driver-app/*": [
        "modules/tms-driver-app-web/src/*"
      ],
      "@shared-api": [
        "packages/shared-api/src"
      ],
      "@shared-api/*": [
        "packages/shared-api/src/*"
      ],
      "@shared-auth": [
        "packages/shared-auth/src"
      ],
      "@shared-auth/*": [
        "packages/shared-auth/src/*"
      ],
      "@shared-ui": [
        "packages/shared-ui/src"
      ],
      "@shared-ui/*": [
        "packages/shared-ui/src/*"
      ],
      "@shared-utils": [
        "packages/shared-utils/src"
      ],
      "@shared-utils/*": [
        "packages/shared-utils/src/*"
      ]
    }
  },
  "include": [
    "src",
    "modules",
    "packages",
    "vite.config.ts"
  ]
}
