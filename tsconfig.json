{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/shared/components/common": ["modules/platform-admin-web/src/components/common"],
      "@/shared/components/common/*": ["modules/platform-admin-web/src/components/common/*"],
      "@/shared/components/ui": ["modules/platform-admin-web/src/components/ui"],
      "@/shared/components/ui/*": ["modules/platform-admin-web/src/components/ui/*"],
      "@/shared/auth": ["modules/platform-admin-web/src/shared/auth"],
      "@/shared/auth/*": ["modules/platform-admin-web/src/shared/auth/*"],
      "@/shared/lib": ["modules/platform-admin-web/src/lib"],
      "@/shared/lib/*": ["modules/platform-admin-web/src/lib/*"],
      "@/shared/store": ["modules/platform-admin-web/src/store"],
      "@/shared/store/*": ["modules/platform-admin-web/src/store/*"],
      "@/types": ["modules/platform-admin-web/src/types"],
      "@/modules/platform-admin": ["modules/platform-admin"],
      "@/modules/platform-admin/*": ["modules/platform-admin/*"],
      "@admin":    ["modules/auction-web/src"],
      "@admin/*":  ["modules/auction-web/src/*"],
      "@admin-web":    ["modules/admin-web/src"],
      "@admin-web/*":  ["modules/admin-web/src/*"],
      "@auction":  ["modules/auction-web/src"],
      "@auction/*":["modules/auction-web/src/*"],
      "@vendor": ["modules/vendor-web/src"],
      "@vendor/*": ["modules/vendor-web/src/*"],
      "@fleet": ["modules/fleet-web/src"],
      "@fleet/*": ["modules/fleet-web/src/*"],
      "@customer": ["modules/customer-web/src"],
      "@customer/*": ["modules/customer-web/src/*"],
      "@console": ["modules/console-web/src"],
      "@console/*": ["modules/console-web/src/*"],
      "@platform-admin": ["modules/platform-admin-web/src"],
      "@platform-admin/*": ["modules/platform-admin-web/src/*"],
      "@tenant-admin": ["modules/tenant-admin-web/src"],
      "@tenant-admin/*": ["modules/tenant-admin-web/src/*"],
      "@tms-booking": ["modules/tms-booking-web/src"],
      "@tms-booking/*": ["modules/tms-booking-web/src/*"],
      "@tms-driver-app": ["modules/tms-driver-app-web/src"],
      "@tms-driver-app/*": ["modules/tms-driver-app-web/src/*"],
      "@shared-api": ["packages/shared-api/src"],
      "@shared-api/*": ["packages/shared-api/src/*"],
      "@shared-auth": ["packages/shared-auth/src"],
      "@shared-auth/*": ["packages/shared-auth/src/*"],
      "@shared-ui": ["packages/shared-ui/src"],
      "@shared-ui/*": ["packages/shared-ui/src/*"],
      "@/components/*": ["modules/tms-driver-app-web/src/components/*"],
      "@/pages/*": ["modules/tms-driver-app-web/src/pages/*"],
      "@/store/*": ["modules/tms-driver-app-web/src/store/*"],
      "@/mocks/*": ["modules/tms-driver-app-web/src/mocks/*"],
      "@/lib/*": ["modules/tms-driver-app-web/src/lib/*"],
      "@/data/*": ["modules/tms-driver-app-web/src/data/*"],
      "@/router/*": ["modules/tms-driver-app-web/src/router/*"],
      "@/types/*": ["modules/platform-admin-web/src/types/*", "modules/tms-driver-app-web/src/types/*"],
      "@/services/*": ["modules/tms-driver-app-web/src/services/*"],
      "@/hooks/*": ["modules/tms-driver-app-web/src/hooks/*"],
      "@/i18n/*": ["modules/tms-driver-app-web/src/i18n/*"],
      "@/utils/*": ["modules/tms-driver-app-web/src/utils/*"],
      "@shared-utils": ["packages/shared-utils/src"],
      "@shared-utils/*": ["packages/shared-utils/src/*"]
    }
  },
  "include": ["src", "modules", "packages", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "modules/tenant-admin",
    "modules/tms",
    "modules/admin-web",
    "modules/console-web",
    "modules/customer-web",
    "modules/tms-driver-app-web",
    "modules/platform-admin",
    "modules/platform-admin-web"
  ]
}
