{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@admin": ["apps/admin-web/src"],
      "@admin/*": ["apps/admin-web/src/*"],
      "@vendor": ["apps/vendor-web/src"],
      "@vendor/*": ["apps/vendor-web/src/*"],
      "@fleet": ["apps/fleet-web/src"],
      "@fleet/*": ["apps/fleet-web/src/*"],
      "@driver": ["apps/driver-web/src"],
      "@driver/*": ["apps/driver-web/src/*"],
      "@customer": ["apps/customer-web/src"],
      "@customer/*": ["apps/customer-web/src/*"],
      "@shared-api": ["packages/shared-api/src"],
      "@shared-api/*": ["packages/shared-api/src/*"],
      "@shared-auth": ["packages/shared-auth/src"],
      "@shared-auth/*": ["packages/shared-auth/src/*"],
      "@shared-ui": ["packages/shared-ui/src"],
      "@shared-ui/*": ["packages/shared-ui/src/*"],
      "@shared-utils": ["packages/shared-utils/src"],
      "@shared-utils/*": ["packages/shared-utils/src/*"]
    }
  },
  "include": ["src", "apps", "packages", "vite.config.ts"]
}
